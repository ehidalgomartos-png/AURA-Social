# RedLibertad V1.70 — environment template
# Never commit real secrets. Copy these names into Coolify and replace placeholders.

NODE_ENV=production
PORT=3000

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@example.com
ADMIN_RECOVERY_TOKEN=replace-with-a-long-random-recovery-token

APP_ORIGIN=https://redlibertad.example
COOKIE_SECURE=true

MEDIA_STORAGE=local
UPLOAD_DIR=/data/uploads
MAX_IMAGE_MB=15
MAX_VIDEO_MB=250

# Optional critical-incident escalation webhook (Slack or Discord only).
# Leave empty to disable all outbound incident notifications. Set in Coolify, not GitHub.
OPS_ALERT_WEBHOOK_URL=

# Optional Web Push. Leave all three empty to keep push disabled.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:admin@example.com

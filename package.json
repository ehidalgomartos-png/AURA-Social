{
  "name": "redlibertad-social",
  "version": "2.10.0",
  "private": true,
  "description": "RedLibertad V2.10 — categorías push elegidas por cada usuario y notificaciones sin leer fiables.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:init": "node db/init.js",
    "check:syntax": "node scripts/check-syntax.js",
    "test:legal": "node --test tests/legal-consent-timeline.test.js tests/legal-consent-receipt.test.js tests/legal-consent-readable.test.js tests/legal-consent-filters.test.js tests/legal-status-overview.test.js",
    "test:smoke": "node --test tests/stability-*.test.js",
    "test": "node --test tests/*.test.js",
    "smoke:production": "node scripts/smoke-http.js",
    "test:social": "node --test tests/social-experience.test.js",
    "test:discovery": "node --test tests/discovery-v28.test.js",
    "test:activation": "node --test tests/activation-v29.test.js",
    "test:notifications": "node --test tests/notifications-v210.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "zod": "^3.24.2",
    "multer": "^2.0.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
